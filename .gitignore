# Unity generated folders to ignore
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Autogenerated IDE solution and project files (Visual Studio / Rider)
.vscode/
.vs/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for ignored files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt
crashlytics-build.properties

# Builds and Archives
*.apk
*.aab
*.unitypackage
*.app

# =========================
# ML-AGENTS SPECIFIC EXCLUSIONS
# =========================

# PyTorch intermediate checkpoints (Massive files used for resuming)
*.pt
*.pt.meta

# TensorBoard logging data (Massive files used for graphs)
run_logs/
run_logs.meta

# ML-Agent training stat trackers (Optional, but cleans up the repo)
timers.json
timers.json.meta
training_status.json
training_status.json.meta
